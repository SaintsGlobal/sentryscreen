<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Stable bundle identity is the whole point of the .app wrapper: TCC
	     keys the Screen Recording grant to this identifier + code signature.
	     Changing it orphans every existing grant. -->
	<key>CFBundleIdentifier</key>
	<string>com.sentryscreen.agent</string>
	<key>CFBundleName</key>
	<string>SentryScreen</string>
	<key>CFBundleExecutable</key>
	<string>sentry-screen</string>
	<key>CFBundleIconFile</key>
	<string>SentryScreen</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.0</string>
	<key>CFBundleVersion</key>
	<string>27</string>
	<!-- Background agent: no Dock icon, no menu bar takeover. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 SentryScreen, LLC. AGPL-3.0</string>
</dict>
</plist>
