# Release metadata shared by scripts/build.sh and the packaging scripts.
# Sourced with bash; keep it plain KEY=VALUE.
SENTRY_VERSION=0.4.2
SENTRY_BUILD=29
# Where the app sends a diagnostic report the owner reviews and chooses to send.
# packaging/bundle.sh writes it into Info.plist (SentryDiagnosticsURL). Forks set
# their own receiver here.
SENTRY_DIAGNOSTICS_URL="${SENTRY_DIAGNOSTICS_URL:-https://api.sentry-screen.com/v1/diagnostics}"
SENTRY_BUNDLE_ID=com.sentryscreen.agent
SENTRY_PACKAGE_ID=com.sentryscreen.pkg
SENTRY_EXECUTABLE=sentry-screen
SENTRY_MIN_MACOS=14.0
# One universal package. Keep the list C-locale sorted: `lipo -archs` output is
# normalized to this order before it is compared. scripts/build.sh honors
# SENTRY_BUILD_ARCHS (for example arm64) for a faster thin development build;
# packaging always builds this full list.
SENTRY_ARCHS="arm64 x86_64"
SENTRY_ARCH="${SENTRY_ARCHS// /,}"
# Team ID that certificate-signed builds bind their designated requirement to
# (packaging/bundle.sh). Required when signing with a certificate; the ad-hoc
# default does not use it.
SENTRY_TEAM_ID="${SENTRY_TEAM_ID:-}"
# Basename of the detector model inside the install directory. The committed
# model at model/weights/ has this name, and packaging/release-model.manifest
# records its identity.
SENTRY_MODEL_FILE="${SENTRY_MODEL_FILE:-yolox_50ep_v8_ep50_fp16.mlpackage}"
# The value is spliced into sed and launchd config, so only a plain basename is safe.
case "$SENTRY_MODEL_FILE" in
  "" | .* | *[!A-Za-z0-9._-]*)
    echo "release.env: SENTRY_MODEL_FILE configured=safe-basename observed='$SENTRY_MODEL_FILE' remediation=packaging/release.env" >&2
    exit 64
    ;;
esac
